# --- secrets / env (ห้ามขึ้น GitHub เด็ดขาด) ---
.env
.env.*
*.env
secrets*
*.key
*.pem
id_ed25519
id_rsa
*.token
ivanti*.json.local

# public keys ผู้เรียน (วางเฉพาะตอน provision จริง)
scripts/pubkeys/*.pub

# --- node ---
node_modules/
npm-debug.log*

# --- editor / OS ---
.DS_Store
.vscode/
.idea/
*.swp

# --- build output (สไลด์ที่ render จาก slides.md) ---
slides/slides.html
slides/slides.pdf
# หมายเหตุ: infographic.html เป็นไฟล์ต้นฉบับ (track ไว้) ไม่ใช่ build output
# .pptx: ไม่ track (สร้างใหม่ได้ด้วย slides/build-pptx.sh) — ถ้าจะแชร์ทีมผ่าน repo ค่อยลบบรรทัดล่าง
slides/*.pptx
